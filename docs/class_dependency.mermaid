flowchart TD
    ui["ui<br/>RunController"]
    orchestrator["orchestrator<br/>run · resume · SQLite checkpointer"]
    graph_["graph<br/>StateGraph · AgentState · nodes"]
    core["core<br/>AgentKernel · registry · events · state"]
    discipline["discipline<br/>Budget · JSON gate · finish gate"]
    observability["observability<br/>EventLogger"]
    features["features<br/>LLM and tool capabilities"]
    toolbox["toolbox + safety<br/>filesystem · terminal · policy"]
    sqlite[("langgraph.sqlite")]

    ui --> orchestrator
    orchestrator --> graph_
    orchestrator --> sqlite
    graph_ --> core
    graph_ --> discipline
    core --> features
    features --> toolbox
    core --> observability

    classDef kernel fill:#F1EFE8,stroke:#5F5E5A,color:#2C2C2A;
    classDef runtime fill:#EEEDFE,stroke:#534AB7,color:#26215C;
    classDef support fill:#E1F5EE,stroke:#0F6E56,color:#04342C;

    class core kernel;
    class graph_,orchestrator runtime;
    class discipline,observability,sqlite support;
