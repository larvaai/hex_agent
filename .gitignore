# runtime artifacts (never commit)
var/
*.log

# os / tooling
.DS_Store
.coverage

# harness runtime state (telemetry/sessions — never commit)
harness/state/

# claude runtime (project settings.json is tracked; runtime/local are not)
.claude/agent-memory/
.claude/settings.local.json

# decision-register lock
docs/.decision_register.lock

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/
